@model SmartInventory.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1>Edit Product</h1>
        <p class="text-muted">
            Update the product information and inventory details.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h4 class="mb-4">Product Information</h4>

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row">

                    <!-- Product Name -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label">
                            Product Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter product name" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <!-- Category -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Category" class="form-label">
                            Category
                        </label>

                        <input asp-for="Category"
                               class="form-control"
                               placeholder="Enter category" />

                        <span asp-validation-for="Category"
                              class="text-danger"></span>
                    </div>

                    <!-- Stock Quantity -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="StockQuantity" class="form-label">
                            Stock Quantity
                        </label>

                        <input asp-for="StockQuantity"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="StockQuantity"
                              class="text-danger"></span>
                    </div>

                    <!-- Reorder Level -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="ReorderLevel" class="form-label">
                            Reorder Level
                        </label>

                        <input asp-for="ReorderLevel"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="ReorderLevel"
                              class="text-danger"></span>
                    </div>

                    <!-- Price -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label">
                            Price
                        </label>

                        <input asp-for="Price"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control" />

                        <span asp-validation-for="Price"
                              class="text-danger"></span>
                    </div>

                    <!-- Daily Sales -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="DailySales" class="form-label">
                            Daily Sales
                        </label>

                        <input asp-for="DailySales"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control" />

                        <span asp-validation-for="DailySales"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <button type="submit" class="btn btn-primary me-2">
                    Save Changes
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Back to Products
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}