@model IEnumerable<SmartInventory.Models.Product>

@{
    ViewData["Title"] = "Stock Prediction";
}

<h1>Smart Stock Prediction</h1>

<p>
    This page predicts approximately how many days each product's
    current stock will last.
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Product</th>
            <th>Current Stock</th>
            <th>Daily Sales</th>
            <th>Reorder Level</th>
            <th>Estimated Days Remaining</th>
            <th>Status</th>
            <th>Recommendation</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            double daysRemaining = 0;

            if (product.DailySales > 0)
            {
                daysRemaining = product.StockQuantity / product.DailySales;
            }

            string status;
            string recommendation;

            if (product.StockQuantity == 0)
            {
                status = "OUT OF STOCK";
                recommendation = "Restock immediately";
            }
            else if (daysRemaining <= 3)
            {
                status = "URGENT";
                recommendation = "Restock immediately";
            }
            else if (product.StockQuantity <= product.ReorderLevel || daysRemaining <= 7)
            {
                status = "LOW STOCK";
                recommendation = "Consider restocking soon";
            }
            else
            {
                status = "NORMAL";
                recommendation = "Stock level is sufficient";
            }

            <tr>
                <td>@product.Name</td>
                <td>@product.StockQuantity</td>
                <td>@product.DailySales</td>
                <td>@product.ReorderLevel</td>
                <td>@daysRemaining.ToString("0.0") days</td>
                <td><strong>@status</strong></td>
                <td>@recommendation</td>
            </tr>
        }
    </tbody>
</table>